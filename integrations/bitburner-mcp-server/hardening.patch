+const GAME_API_BASE_URL = process.env.BB_GAME_API_BASE_URL || "";
+const GAME_API_TOKEN = process.env.BB_GAME_API_TOKEN || "";
+
+const GAME_TOOLS = [
+  ["game_observe", "Observe the current rendered Bitburner UI and dialogs", {}, []],
+  ["game_progress", "Report money, hacking level, and visible script income", {
+    baseline_money: { type: "string" }, baseline_hacking_level: { type: "integer" },
+  }, []],
+  ["game_open_tab", "Open an allowlisted Bitburner tab using a fresh visible label", {
+    tab: { type: "string", enum: ["Terminal", "Active Scripts", "Stats", "Milestones", "Documentation", "Hacknet", "City", "Travel", "Create Program"] },
+  }, ["tab"]],
+  ["game_dismiss_dialog", "Dismiss one visible in-game dialog and verify it closed", {}, []],
+  ["game_terminal", "Run one validated command in the visible Bitburner terminal", {
+    command: { type: "string" },
+  }, ["command"]],
+  ["game_run_script", "Run a script through the visible terminal and return the game's result", {
+    filename: { type: "string" }, args: { type: "array", items: { type: "string" } },
+  }, ["filename"]],
+  ["game_read_script", "Read one simple JavaScript file on home through the restricted Remote API", {
+    filename: { type: "string" },
+  }, ["filename"]],
+  ["game_deploy_script", "Deploy model-authored Netscript with read-back, RAM validation, and run-before-redeploy safeguards", {
+    filename: { type: "string" }, content: { type: "string" },
+  }, ["filename", "content"]],
+  ["game_netscript_reference", "Look up an exact Netscript signature and nearby official documentation", {
+    symbol: { type: "string" },
+  }, ["symbol"]],
+  ["game_help", "Retrieve a concise allowlisted Bitburner guide section", {
+    topic: { type: "string" },
+  }, ["topic"]],
+  ["game_troubleshoot", "Retrieve recovery guidance for the actual visible game or tool error", {
+    error: { type: "string" },
+  }, ["error"]],
+] as const;
+
+async function gameApiCall(name: string, args: Record<string, unknown> = {}): Promise<unknown> {
+  if (!GAME_API_BASE_URL || !GAME_API_TOKEN) {
+    throw new Error("Agent Zero browser tool endpoint is not configured");
+  }
+  const response = await fetch(`${GAME_API_BASE_URL}/api/agent-zero/tools/${encodeURIComponent(name)}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", Authorization: `Bearer ${GAME_API_TOKEN}` },
+    body: JSON.stringify(args),
+  });
+  let payload: { result?: unknown; detail?: string; success?: boolean };
+  try {
+    payload = await response.json() as typeof payload;
+  } catch {
+    throw new Error(`${name} returned HTTP ${response.status} without a JSON result`);
+  }
+  if (!response.ok) {
+    throw new Error(`${name} returned HTTP ${response.status}: ${payload.detail || "tool call failed"}`);
+  }
+  return payload.result;
+}

