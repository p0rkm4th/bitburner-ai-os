# Copy to /opt/bitburner-agent/config/.env and set the locally verified values.
OLLAMA_BASE_URL=http://REPLACE_WITH_PRIVATE_INFERENCE_HOST:11434
OLLAMA_MODEL=REPLACE_WITH_VERIFIED_MODEL
INFERENCE_NODE=REPLACE_WITH_NODE_NAME
OLLAMA_TIMEOUT=120
MAX_STEPS=16
MAX_HISTORY_ITEMS=6
CHECKPOINT_PROMPT_LIMIT=1600
MAX_FAILURES=2
IDLE_TIMEOUT=900
MAX_SESSIONS=0
MAX_SESSION_SECONDS=3600
NO_PROGRESS_SESSIONS=5
MAX_RETRIES=2
SESSION_DELAY=60
AUTO_RESUME=0
# Set to 1 only when deliberate human intervention is needed in the viewer.
VNC_INTERACTIVE=0
